# Supply Python slim and kubectl images pinned by SHA-256 digest.
ARG PYTHON_IMAGE
ARG KUBECTL_IMAGE
FROM ${KUBECTL_IMAGE} AS kubectl
FROM ${PYTHON_IMAGE}
COPY --from=kubectl /bin/kubectl /usr/local/bin/kubectl
WORKDIR /app
COPY requirements.txt .
RUN python3 -m venv /opt/drydock \
    && /opt/drydock/bin/pip install --no-cache-dir -r requirements.txt
COPY drydock/ drydock/
ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["/opt/drydock/bin/python", "-m", "drydock"]
